@using McMotd.Data;
@using McMotd;
@using McMotd.Enum
@using System.Text
@using System.Text.Encodings.Web
<div class="mcmotd-container">
    @foreach(var component in motd.Components)
    {
        @if (component.LineBreak)
        {
            <br/>
        }
        <span class="@getStyle(component.TextFormatting) mcmotd-text" style="color: @component.Color">
            @if (component.TextFormatting.Contains(MotdTextFormat.Bold))
            {
                <strong>@component.Text</strong>
            }else
            {
                @component.Text    
            }
        </span>
    }
</div>
@code{
    [Parameter]
    public string RawMotdString { get; set; }

    private Motd motd;

    protected override void OnInitialized() {
        motd = RawMotdString;
        base.OnInitialized();
    }

    private string getStyle(HashSet<MotdTextFormat> TextFormats)
    {
        StringBuilder sb = new StringBuilder();
        foreach (var TextFormat in TextFormats)
        {
            switch (TextFormat)
            {
                case MotdTextFormat.Bold:
                    sb.Append("mcmotd-text-bold");
                    break;
                case MotdTextFormat.Italic:
                    sb.Append("mcmotd-text-italic");
                    break;
                case MotdTextFormat.Underline:
                    sb.Append("mcmotd-text-underline");
                    break;
                case MotdTextFormat.Striktethrough:
                    sb.Append("mcmotd-text-strikethrough");
                    break;    
                default:
                    sb.Append("mcmotd-text-normal");
                    break;
            }
            sb.Append(" ");
        }
        return sb.ToString();
    }
} 